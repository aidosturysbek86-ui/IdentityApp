@model IEnumerable<IdentityApp.Models.ApplicationUser>
@{
    ViewData["Title"] = "Студенттер тізімі";
}

<h2>Студенттер тізімі</h2>

<table class="table">
    <thead>
        <tr>
            <th>Аты</th>
            <th>Тегі</th>
            <th>Email</th>
            <th>Әрекеттер</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Email</td>
                <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger btn-sm">Жою</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>